---
import ProductCard from '@components/ProductCard.astro';
import Filter from '@components/catalog/Filter.tsx';
import SkeletonCatalog from '@components/SkeletonCatalog.astro';
import type { Book } from '@app-types/book';
import type { Product } from '@app-types/product';
import {
  DEFAULT_EXAM_TYPE,
  DEFAULT_FORMAT,
  DEFAULT_LEVEL,
  DEFAULT_RESOURCE_TYPE,
  DEFAULT_SORT,
  getGridClassFromColumns,
  processProducts,
} from '@utils/catalogFilters';

interface Props {
  books: Book[];
  initialLevel?: string;
  initialFormat?: string;
  initialSort?: string;
  editorialMap?: Map<string, string>;
  gridCols?: number;
  productSize?: 'small' | 'medium' | 'large';
  useSkeleton?: boolean;
}

const {
  books = [],
  initialLevel = DEFAULT_LEVEL,
  initialFormat = DEFAULT_FORMAT,
  initialSort = DEFAULT_SORT,
  editorialMap = new Map(),
  gridCols = 5,
  productSize = 'medium',
  useSkeleton = true,
} = Astro.props;

const products: Product[] = books.map((book) => ({
  ...book,
  productType: 'book' as const,
  formatTags: book.formatTags ?? [],
}));

// Server-render with the exact same function the client re-runs on every
// filter change (see src/utils/catalogFilters.ts).
const filteredProducts = processProducts(
  products,
  {
    resourceType: DEFAULT_RESOURCE_TYPE,
    level: initialLevel,
    format: initialFormat,
    examType: DEFAULT_EXAM_TYPE,
    search: '',
  },
  initialSort
);

const gridClass = getGridClassFromColumns(gridCols);
const showSkeletonOnLoad = useSkeleton && filteredProducts.length > 10;
---

<div class="catalog-book-container">
  <Filter
    initialLevel={initialLevel}
    initialFormat={initialFormat}
    initialSort={initialSort}
    productCount={filteredProducts.length}
    productType="book"
    className="mb-8 shadow-lg"
    client:visible
  />

  <div id="books-container" data-is-loading={showSkeletonOnLoad.toString()}>
    {
      showSkeletonOnLoad && (
        <div id="skeleton-loader" class="skeleton-container">
          <SkeletonCatalog count={gridCols * 2} />
        </div>
      )
    }

    <div
      id="books-grid"
      class={`grid ${gridClass} gap-4 sm:gap-6 ${showSkeletonOnLoad ? 'opacity-0' : ''}`}
    >
      {
        products.map((product) => {
          const isInitiallyVisible = filteredProducts.some((p) => p.id === product.id);
          return (
            <div
              class={`catalog-product-card ${isInitiallyVisible ? '' : 'hidden'}`}
              data-product-id={product.id}
            >
              <ProductCard
                product={product}
                size={productSize}
                editorial={product.editorialId ? editorialMap.get(product.editorialId) : undefined}
              />
            </div>
          );
        })
      }
    </div>

    <div
      id="no-results"
      class={`bg-neutral-light/50 col-span-full rounded-lg py-16 text-center ${filteredProducts.length === 0 ? '' : 'hidden'}`}
    >
      <div class="mb-4 text-5xl">🔍</div>
      <h3 class="text-primary-dark mb-2 text-xl font-semibold">No se encontraron libros</h3>
      <p class="mb-6 text-gray-500">
        Lo sentimos, no hay libros que coincidan con los filtros seleccionados.
      </p>
      <button
        id="reset-filters"
        class="bg-primary hover:bg-primary-dark rounded-lg px-6 py-2 font-medium text-white transition-all duration-300"
      >
        Reiniciar filtros
      </button>
    </div>

    <div class="results-summary mt-6 rounded-lg bg-white p-4 text-center shadow-sm">
      <p class="text-sm text-gray-600">
        Mostrando <span class="result-count font-semibold">{filteredProducts.length}</span>{' '}
        {filteredProducts.length === 1 ? 'libro' : 'libros'}
      </p>
    </div>
  </div>

  <!-- Real product data for client-side filtering — parsed once, never
       reconstructed from data-* attributes on the cards. -->
  <script
    type="application/json"
    id="catalog-products-data"
    set:html={JSON.stringify(products)}
    is:inline
  />
</div>

<script>
  import {
    filterProducts,
    sortProducts,
    buildCatalogURL,
    parseCatalogParams,
    DEFAULT_LEVEL,
    DEFAULT_FORMAT,
    DEFAULT_SORT,
    DEFAULT_SEARCH,
  } from '@utils/catalogFilters';
  import { applyProductOrder } from '@utils/catalogDom';
  import type { Product } from '@app-types/product';
  import type { CatalogFilterChangeDetail } from '@components/catalog/Filter.tsx';

  const dataEl = document.getElementById('catalog-products-data');
  const allProducts: Product[] = dataEl?.textContent ? JSON.parse(dataEl.textContent) : [];

  const booksGridEl = document.getElementById('books-grid');

  // Computes the filtered/sorted result and applies it to the DOM. This is
  // the ONLY place that touches the grid's visibility/order — both the
  // animated "user changed a filter" path and the silent "deep link on load"
  // path below call through it, so they can never disagree.
  const computeAndApply = (detail: CatalogFilterChangeDetail): number => {
    if (!booksGridEl) return 0;
    const filtered = filterProducts(allProducts, detail);
    const sorted = sortProducts(filtered, detail.sort);
    const orderedIds = sorted.map((p) => p.id);
    const items = Array.from(booksGridEl.querySelectorAll('.catalog-product-card'));
    return applyProductOrder(booksGridEl, items, orderedIds);
  };

  const applyFilters = (detail: CatalogFilterChangeDetail): void => {
    const booksContainer = document.getElementById('books-container');
    const skeletonLoader = document.getElementById('skeleton-loader');
    const noResults = document.getElementById('no-results');
    const resultCountEls = document.querySelectorAll('.result-count');

    document.body.classList.add('filters-loading');
    booksContainer?.setAttribute('data-is-loading', 'true');

    if (booksGridEl) {
      booksGridEl.classList.add('opacity-0');
      booksGridEl.style.position = 'absolute';
      booksGridEl.style.visibility = 'hidden';
    }
    if (skeletonLoader) {
      skeletonLoader.style.display = 'block';
      skeletonLoader.style.opacity = '1';
    }

    // Filtering runs over an in-memory array already on the page — there's
    // no real async work here, so no artificial delay before it (see #62).
    const visibleCount = computeAndApply(detail);

    window.history.replaceState({}, '', buildCatalogURL(window.location.href, detail));

    resultCountEls.forEach((el) => (el.textContent = String(visibleCount)));
    noResults?.classList.toggle('hidden', visibleCount !== 0);

    document.body.classList.remove('filters-loading');
    booksContainer?.setAttribute('data-is-loading', 'false');

    if (skeletonLoader) {
      skeletonLoader.style.opacity = '0';
      setTimeout(() => {
        skeletonLoader.style.display = 'none';
      }, 300); // Kept: matches the skeleton's actual CSS opacity transition duration.
    }
    if (booksGridEl) {
      booksGridEl.classList.remove('opacity-0');
      booksGridEl.style.position = 'static';
      booksGridEl.style.visibility = 'visible';
    }

    window.dispatchEvent(new CustomEvent('updateFilterCount', { detail: { count: visibleCount } }));
  };

  const handleFilterChange = (event: Event) => {
    applyFilters((event as CustomEvent<CatalogFilterChangeDetail>).detail);
  };

  const resetButton = document.getElementById('reset-filters');
  resetButton?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('resetFilters'));
    applyFilters({
      level: 'all',
      format: 'all',
      examType: 'all',
      sort: 'featured',
      resourceType: 'any',
      search: '',
    });
  });

  window.addEventListener('filterChange', handleFilterChange as EventListener);

  document.addEventListener('DOMContentLoaded', () => {
    const booksContainer = document.getElementById('books-container');
    const skeletonLoader = document.getElementById('skeleton-loader');
    const noResults = document.getElementById('no-results');
    const resultCountEls = document.querySelectorAll('.result-count');

    if (booksContainer && booksContainer.getAttribute('data-is-loading') === 'true') {
      // The grid is already server-rendered — reveal it immediately
      // instead of holding the skeleton up with an artificial delay (#62).
      if (skeletonLoader) (skeletonLoader as HTMLElement).style.opacity = '0';
      if (booksGridEl) {
        booksGridEl.classList.remove('opacity-0');
        booksGridEl.style.position = 'static';
        booksGridEl.style.visibility = 'visible';
      }
      booksContainer.setAttribute('data-is-loading', 'false');
    }

    // This site builds as fully static output with no SSR adapter — the
    // markup above was rendered at BUILD time, when there is no real request
    // and therefore no query string. A deep link like ?level=basic only
    // reflects the right books because this runs client-side, where
    // location.search is the actual browser URL. Skips the loading/skeleton
    // choreography (this is a correction on first paint, not a user action).
    const initialParams = parseCatalogParams(new URLSearchParams(window.location.search));
    const isNonDefault =
      initialParams.level !== DEFAULT_LEVEL ||
      initialParams.format !== DEFAULT_FORMAT ||
      initialParams.sort !== DEFAULT_SORT ||
      initialParams.search !== DEFAULT_SEARCH;

    if (isNonDefault) {
      const visibleCount = computeAndApply(initialParams);
      resultCountEls.forEach((el) => (el.textContent = String(visibleCount)));
      noResults?.classList.toggle('hidden', visibleCount !== 0);
      window.dispatchEvent(
        new CustomEvent('updateFilterCount', { detail: { count: visibleCount } })
      );
    }
  });
</script>

<style>
  body.filters-loading .books-grid::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.2) 20%,
      rgba(255, 255, 255, 0.5) 60%,
      rgba(255, 255, 255, 0.2) 80%,
      rgba(255, 255, 255, 0) 100%
    );
    background-size: 200% 100%;
    animation: shine 1.5s infinite linear;
    z-index: 10;
    pointer-events: none;
  }

  @keyframes shine {
    to {
      background-position: 200% 0;
    }
  }

  .catalog-product-card {
    transition:
      opacity 0.5s ease,
      transform 0.5s cubic-bezier(0.23, 1, 0.32, 1);
  }

  #skeleton-loader {
    transition: opacity 0.3s ease-out;
  }

  #books-grid.opacity-0 {
    position: absolute;
    visibility: hidden;
  }

  [data-is-loading='false'] #skeleton-loader {
    display: none;
  }

  .catalog-product-card {
    animation: fadeInUp 0.5s ease forwards;
    animation-play-state: paused;
  }

  [data-is-loading='false'] .catalog-product-card:not(.hidden) {
    animation-play-state: running;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
