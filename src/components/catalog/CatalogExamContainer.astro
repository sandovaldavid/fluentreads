---
import ProductCard from '@components/ProductCard.astro';
import Filter from '@components/catalog/Filter.tsx';
import SkeletonCatalog from '@components/SkeletonCatalog.astro';
import type { Exam } from '@app-types/exam';
import type { Product } from '@app-types/product';
import {
  DEFAULT_EXAM_TYPE,
  DEFAULT_FORMAT,
  DEFAULT_LEVEL,
  DEFAULT_RESOURCE_TYPE,
  DEFAULT_SORT,
  processProducts,
} from '@utils/catalogFilters';

interface Props {
  exams: Exam[];
  initialLevel?: string;
  initialFormat?: string;
  initialExamType?: string;
  initialSort?: string;
  gridCols?: number;
  productSize?: 'small' | 'medium' | 'large';
  useSkeleton?: boolean;
}

const {
  exams = [],
  initialLevel = DEFAULT_LEVEL,
  initialFormat = DEFAULT_FORMAT,
  initialExamType = DEFAULT_EXAM_TYPE,
  initialSort = DEFAULT_SORT,
  gridCols = 4,
  productSize = 'medium',
  useSkeleton = true,
} = Astro.props;

const products: Product[] = exams.map((exam) => ({
  ...exam,
  productType: 'exam' as const,
  formatTags: exam.formatTags ?? [],
  level: exam.difficulty, // Map difficulty to level for the shared filter engine
}));

// Server-render with the exact same function the client re-runs on every
// filter change (see src/utils/catalogFilters.ts). Previously this container
// used its own underscore-separated sort values (price_low/name_asc) that
// didn't match what Filter.tsx ever sends (price-low/price-high/bestseller),
// causing the initial SSR order to silently desync from the applied filter
// UI state on reload — that class of bug is now impossible since both sides
// call the same function with the same vocabulary.
const filteredProducts = processProducts(
  products,
  {
    resourceType: DEFAULT_RESOURCE_TYPE,
    level: initialLevel,
    format: initialFormat,
    examType: initialExamType,
    search: '',
  },
  initialSort
);

function getGridClass(count: number): string {
  if (count <= 2) return 'grid-cols-1 sm:grid-cols-2';
  if (count === 3) return 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3';
  return 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4';
}

const showSkeletonOnLoad = useSkeleton && filteredProducts.length > 8;
---

<div class="catalog-container" id="exams-container" data-is-loading={showSkeletonOnLoad.toString()}>
  <Filter
    client:visible
    initialLevel={initialLevel}
    initialFormat={initialFormat}
    initialExamType={initialExamType}
    initialSort={initialSort}
    enableExamTypeFilter={true}
    productType="exam"
    productCount={filteredProducts.length}
    className="mb-8 shadow-lg"
  />

  {
    useSkeleton && (
      <div
        id="skeleton-loader"
        class="skeleton-container"
        style={showSkeletonOnLoad ? '' : 'display: none;'}
      >
        <SkeletonCatalog count={gridCols * 2} />
      </div>
    )
  }

  <div class="mt-6 mb-4 flex items-center justify-between">
    <div class="results-count text-sm text-gray-500">
      <span class="total-count">{filteredProducts.length}</span> exámenes encontrados
    </div>

    <button
      id="reset-filters"
      class="bg-primary-light hover:bg-primary-dark hidden rounded-md px-4 py-2 text-sm text-white transition-colors"
    >
      Restablecer filtros
    </button>
  </div>

  <div
    id="exams-grid"
    class={`grid ${getGridClass(products.length)} relative mb-12 gap-6 transition-all duration-300 md:gap-8 ${showSkeletonOnLoad ? 'opacity-0' : ''}`}
  >
    {
      products.map((product) => {
        const isInitiallyVisible = filteredProducts.some((p) => p.id === product.id);
        return (
          <div
            class={`catalog-product-card ${isInitiallyVisible ? '' : 'hidden'}`}
            data-product-id={product.id}
          >
            <ProductCard product={product} size={productSize} />
          </div>
        );
      })
    }
  </div>

  <div
    id="no-results"
    class={`animate-fadeIn rounded-xl border border-gray-100 bg-white p-8 text-center shadow-sm ${filteredProducts.length === 0 ? '' : 'hidden'}`}
  >
    <h3 class="text-primary-dark mb-3 text-xl font-bold">No se encontraron exámenes</h3>
    <p class="mb-6 text-gray-600">
      No hay exámenes que coincidan con los filtros seleccionados. Prueba con diferentes criterios.
    </p>
    <button
      id="reset-filters-empty"
      class="bg-primary hover:bg-primary-dark rounded-lg px-6 py-2 font-medium text-white transition-all duration-300"
    >
      Reiniciar filtros
    </button>
  </div>

  <!-- Real product data for client-side filtering — parsed once, never
       reconstructed from data-* attributes on the cards. -->
  <script
    type="application/json"
    id="catalog-products-data"
    set:html={JSON.stringify(products)}
    is:inline
  />
</div>

<script>
  import {
    filterProducts,
    sortProducts,
    buildCatalogURL,
    parseCatalogParams,
    DEFAULT_LEVEL,
    DEFAULT_FORMAT,
    DEFAULT_EXAM_TYPE,
    DEFAULT_SORT,
    DEFAULT_SEARCH,
  } from '@utils/catalogFilters';
  import { applyProductOrder } from '@utils/catalogDom';
  import type { Product } from '@app-types/product';
  import type { CatalogFilterChangeDetail } from '@components/catalog/Filter.tsx';

  document.addEventListener('DOMContentLoaded', () => {
    const dataEl = document.getElementById('catalog-products-data');
    const allProducts: Product[] = dataEl?.textContent ? JSON.parse(dataEl.textContent) : [];

    const examsContainer = document.getElementById('exams-container');
    const examsGrid = document.getElementById('exams-grid');
    const skeletonLoader = document.getElementById('skeleton-loader');
    const noResults = document.getElementById('no-results');
    const totalCountEl = document.querySelector('.total-count');
    const resetFiltersBtn = document.getElementById('reset-filters');
    const resetFiltersEmptyBtn = document.getElementById('reset-filters-empty');

    // Computes the filtered/sorted result and applies it to the DOM. This is
    // the ONLY place that touches the grid's visibility/order — both the
    // animated "user changed a filter" path and the silent "deep link on
    // load" path below call through it, so they can never disagree.
    const computeAndApply = (detail: CatalogFilterChangeDetail): number => {
      if (!examsGrid) return 0;
      const filtered = filterProducts(allProducts, detail);
      const sorted = sortProducts(filtered, detail.sort);
      const orderedIds = sorted.map((p) => p.id);
      const items = Array.from(examsGrid.querySelectorAll('.catalog-product-card'));
      return applyProductOrder(examsGrid, items, orderedIds);
    };

    const applyFilters = (detail: CatalogFilterChangeDetail): void => {
      if (!examsContainer || !examsGrid) return;

      document.body.classList.add('filters-loading');
      examsContainer.setAttribute('data-is-loading', 'true');

      if (skeletonLoader) {
        skeletonLoader.style.display = 'block';
        skeletonLoader.style.opacity = '1';
      }
      examsGrid.classList.add('opacity-0');
      examsGrid.style.position = 'absolute';
      examsGrid.style.visibility = 'hidden';

      // Filtering runs over an in-memory array already on the page — there's
      // no real async work here, so no artificial delay before it (see #62).
      const visibleCount = computeAndApply(detail);

      window.history.replaceState({}, '', buildCatalogURL(window.location.href, detail));

      resetFiltersBtn?.classList.toggle(
        'hidden',
        detail.level === 'all' &&
          detail.format === 'all' &&
          detail.examType === 'all' &&
          !detail.search
      );

      if (totalCountEl) totalCountEl.textContent = String(visibleCount);

      if (visibleCount === 0) {
        examsGrid.classList.add('hidden');
        noResults?.classList.remove('hidden');
      } else {
        examsGrid.classList.remove('hidden');
        noResults?.classList.add('hidden');
      }

      document.body.classList.remove('filters-loading');
      examsContainer.setAttribute('data-is-loading', 'false');

      if (skeletonLoader) {
        skeletonLoader.style.opacity = '0';
        // Kept: matches the skeleton's actual CSS opacity transition duration.
        setTimeout(() => {
          skeletonLoader.style.display = 'none';
        }, 300);
      }
      examsGrid.classList.remove('opacity-0');
      examsGrid.style.position = 'static';
      examsGrid.style.visibility = 'visible';

      window.dispatchEvent(
        new CustomEvent('updateFilterCount', { detail: { count: visibleCount } })
      );
    };

    const handleFilterChange = (event: Event) => {
      applyFilters((event as CustomEvent<CatalogFilterChangeDetail>).detail);
    };

    window.addEventListener('filterChange', handleFilterChange as EventListener);

    const resetFilters = () => {
      document.dispatchEvent(new CustomEvent('resetFilters'));
      applyFilters({
        level: 'all',
        format: 'all',
        examType: 'all',
        sort: 'featured',
        resourceType: 'any',
        search: '',
      });
    };

    resetFiltersBtn?.addEventListener('click', resetFilters);
    resetFiltersEmptyBtn?.addEventListener('click', resetFilters);

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );
    document.querySelectorAll('.catalog-product-card').forEach((card) => observer.observe(card));

    // The grid is already server-rendered — reveal it immediately instead
    // of holding the skeleton up with an artificial delay (#62).
    if (examsContainer && examsContainer.getAttribute('data-is-loading') === 'true') {
      if (skeletonLoader) (skeletonLoader as HTMLElement).style.opacity = '0';
      if (examsGrid) {
        examsGrid.classList.remove('opacity-0');
        examsGrid.style.position = 'static';
        examsGrid.style.visibility = 'visible';
      }
      examsContainer.setAttribute('data-is-loading', 'false');

      // Kept: matches the skeleton's actual CSS opacity transition duration.
      setTimeout(() => {
        if (skeletonLoader) (skeletonLoader as HTMLElement).style.display = 'none';
      }, 300);
    }

    // This site builds as fully static output with no SSR adapter — the
    // markup above was rendered at BUILD time, when there is no real request
    // and therefore no query string. A deep link like ?level=advanced only
    // reflects the right exams because this runs client-side, where
    // location.search is the actual browser URL. Skips the loading/skeleton
    // choreography (this is a correction on first paint, not a user action).
    const initialParams = parseCatalogParams(new URLSearchParams(window.location.search));
    const isNonDefault =
      initialParams.level !== DEFAULT_LEVEL ||
      initialParams.format !== DEFAULT_FORMAT ||
      initialParams.examType !== DEFAULT_EXAM_TYPE ||
      initialParams.sort !== DEFAULT_SORT ||
      initialParams.search !== DEFAULT_SEARCH;

    if (isNonDefault && examsGrid) {
      const visibleCount = computeAndApply(initialParams);

      resetFiltersBtn?.classList.toggle(
        'hidden',
        initialParams.level === 'all' &&
          initialParams.format === 'all' &&
          initialParams.examType === 'all' &&
          !initialParams.search
      );
      if (totalCountEl) totalCountEl.textContent = String(visibleCount);
      if (visibleCount === 0) {
        examsGrid.classList.add('hidden');
        noResults?.classList.remove('hidden');
      } else {
        examsGrid.classList.remove('hidden');
        noResults?.classList.add('hidden');
      }
      window.dispatchEvent(
        new CustomEvent('updateFilterCount', { detail: { count: visibleCount } })
      );
    }
  });
</script>

<style>
  body.filters-loading .exams-grid::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.2) 20%,
      rgba(255, 255, 255, 0.5) 60%,
      rgba(255, 255, 255, 0.2) 80%,
      rgba(255, 255, 255, 0) 100%
    );
    background-size: 200% 100%;
    animation: shine 1.5s infinite linear;
    z-index: 10;
    pointer-events: none;
  }

  @keyframes shine {
    to {
      background-position: 200% 0;
    }
  }

  .catalog-product-card {
    transition:
      opacity 0.5s ease,
      transform 0.5s cubic-bezier(0.23, 1, 0.32, 1);
  }

  #skeleton-loader {
    transition: opacity 0.3s ease-out;
  }

  #exams-grid.opacity-0 {
    position: absolute;
    visibility: hidden;
  }

  [data-is-loading='false'] #skeleton-loader {
    display: none;
  }

  .catalog-product-card {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.5s ease forwards;
    animation-play-state: paused;
  }

  [data-is-loading='false'] .catalog-product-card:not(.hidden) {
    animation-play-state: running;
  }

  .catalog-product-card.in-view {
    animation-play-state: running;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .animate-fadeIn {
    animation: fadeIn 0.5s ease-out;
  }
</style>
