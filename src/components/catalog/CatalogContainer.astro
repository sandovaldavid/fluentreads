---
import Filter from '@components/catalog/Filter.tsx';
import SkeletonCatalog from '@components/SkeletonCatalog.astro';
import ProductCard from '@components/ProductCard.astro';
import type { Product } from '@app-types/product';
import {
  DEFAULT_EXAM_TYPE,
  DEFAULT_FORMAT,
  DEFAULT_LEVEL,
  DEFAULT_RESOURCE_TYPE,
  DEFAULT_SORT,
  getGridClassFromColumns,
  processProducts,
} from '@utils/catalogFilters';

interface Props {
  products: Product[];
  initialLevel?: string;
  initialFormat?: string;
  initialSort?: string;
  initialResourceType?: string;
  initialSearch?: string;
  editorialMap?: Map<string, string>;
  gridCols?: number;
  productSize?: 'small' | 'medium' | 'large';
  enableResourceTypeFilter?: boolean;
}

const {
  products = [],
  initialLevel = DEFAULT_LEVEL,
  initialFormat = DEFAULT_FORMAT,
  initialSort = DEFAULT_SORT,
  initialResourceType = DEFAULT_RESOURCE_TYPE,
  editorialMap = new Map(),
  gridCols = 4,
  productSize = 'medium',
  enableResourceTypeFilter = false,
  initialSearch = '',
} = Astro.props;

// Server-render the initial set with the exact same function the client
// re-runs on every filter change, so SSR output and post-filter output can
// never disagree (see src/utils/catalogFilters.ts).
const filteredProducts = processProducts(
  products,
  {
    resourceType: initialResourceType,
    level: initialLevel,
    format: initialFormat,
    examType: DEFAULT_EXAM_TYPE,
    search: initialSearch,
  },
  initialSort
);

const gridClass = getGridClassFromColumns(gridCols);
---

<div class="catalog-container flex flex-col items-center">
  <Filter
    client:visible
    initialLevel={initialLevel}
    initialFormat={initialFormat}
    initialSort={initialSort}
    initialResourceType={initialResourceType}
    initialSearch={initialSearch}
    enableResourceTypeFilter={enableResourceTypeFilter}
    productType={initialResourceType !== DEFAULT_RESOURCE_TYPE ? initialResourceType : undefined}
    productCount={filteredProducts.length}
  />

  <div class="relative w-full">
    <div
      id="loading-indicator"
      class="loading-container absolute inset-0 z-10 hidden rounded-lg bg-white/80"
    >
      <SkeletonCatalog count={gridCols * 2} />
    </div>

    <div
      id="products-grid"
      class={`grid ${gridClass} mt-8 min-h-[300px] px-1 sm:px-4 md:gap-6 md:px-8`}
    >
      {
        products.map((product) => {
          let editorialName = '';
          if (product.productType === 'book' && 'editorialId' in product) {
            const editorialId = product.editorialId;
            if (editorialId && editorialMap.has(editorialId)) {
              editorialName = editorialMap.get(editorialId) || '';
            }
          }

          const isInitiallyVisible = filteredProducts.some((p) => p.id === product.id);

          return (
            <div
              class={`product-grid-item ${isInitiallyVisible ? '' : 'hidden'}`}
              data-product-id={product.id}
            >
              <ProductCard
                product={product}
                size={productSize}
                editorial={editorialName || undefined}
              />
            </div>
          );
        })
      }
    </div>
  </div>

  <div
    id="empty-state"
    class={`px-4 py-16 text-center ${filteredProducts.length === 0 ? '' : 'hidden'}`}
  >
    <div class="mb-4 text-6xl">📚</div>
    <h3 class="mb-2 text-2xl font-bold text-gray-700">
      No hay resultados que coincidan con tus filtros
    </h3>
    <p class="mb-6 text-gray-500">
      Intenta con otros filtros o revisa todas nuestras opciones disponibles
    </p>
    <button
      id="reset-filters"
      class="bg-primary hover:bg-primary-dark rounded-lg px-6 py-2 text-white transition-colors"
    >
      Limpiar filtros
    </button>
  </div>

  <!-- Real product data for client-side filtering — parsed once, never
       reconstructed from data-* attributes on the cards. -->
  <script
    type="application/json"
    id="catalog-products-data"
    set:html={JSON.stringify(products)}
    is:inline
  />
</div>

<script>
  import { getSharedObserver } from '@utils/observer';
  import {
    filterProducts,
    sortProducts,
    buildCatalogURL,
    parseCatalogParams,
    DEFAULT_LEVEL,
    DEFAULT_FORMAT,
    DEFAULT_SORT,
    DEFAULT_SEARCH,
    DEFAULT_RESOURCE_TYPE,
  } from '@utils/catalogFilters';
  import { applyProductOrder } from '@utils/catalogDom';
  import type { Product } from '@app-types/product';
  import type { CatalogFilterChangeDetail } from '@components/catalog/Filter.tsx';

  document.addEventListener('DOMContentLoaded', () => {
    const dataEl = document.getElementById('catalog-products-data');
    const allProducts: Product[] = dataEl?.textContent ? JSON.parse(dataEl.textContent) : [];

    const productsGrid = document.getElementById('products-grid');
    const emptyState = document.getElementById('empty-state');
    const loadingIndicator = document.getElementById('loading-indicator');
    const resetButton = document.getElementById('reset-filters');

    const showLoading = (show: boolean): void => {
      if (!loadingIndicator || !productsGrid) return;
      loadingIndicator.classList.toggle('hidden', !show);
      productsGrid.classList.toggle('filtering', show);
      productsGrid.style.opacity = show ? '0' : '1';
    };

    // Computes the filtered/sorted result and applies it to the DOM. This is
    // the ONLY place that touches the grid's visibility/order — both the
    // animated "user changed a filter" path and the silent "deep link on
    // load" path below call through it, so they can never disagree.
    const computeAndApply = (detail: CatalogFilterChangeDetail): number => {
      const filtered = filterProducts(allProducts, detail);
      const sorted = sortProducts(filtered, detail.sort);
      const orderedIds = sorted.map((p) => p.id);
      if (!productsGrid) return orderedIds.length;
      const items = Array.from(productsGrid.querySelectorAll('.product-grid-item'));
      return applyProductOrder(productsGrid, items, orderedIds);
    };

    const applyFilters = (detail: CatalogFilterChangeDetail): void => {
      showLoading(true);

      // Filtering runs over an in-memory array already on the page — there's
      // no real async work here, so no artificial delay before it (see #62).
      const visibleCount = computeAndApply(detail);

      window.history.replaceState({}, '', buildCatalogURL(window.location.href, detail));

      if (productsGrid) {
        const items = Array.from(productsGrid.querySelectorAll('.product-grid-item'));
        items.forEach((item, index) => {
          if (item.classList.contains('hidden')) return;
          const delayClass = `appear-${(index % 4) + 1}`;
          item.classList.remove('in-view', 'appear-1', 'appear-2', 'appear-3', 'appear-4');
          (item as HTMLElement).style.display = 'none';
          void (item as HTMLElement).offsetWidth;
          (item as HTMLElement).style.display = '';
          setTimeout(() => item.classList.add('in-view', delayClass), 50);
        });
      }

      emptyState?.classList.toggle('hidden', visibleCount !== 0);
      showLoading(false);

      window.dispatchEvent(
        new CustomEvent('updateFilterCount', { detail: { count: visibleCount } })
      );
    };

    const handleFilterChange = (event: Event): void => {
      applyFilters((event as CustomEvent<CatalogFilterChangeDetail>).detail);
    };

    if (resetButton) {
      resetButton.addEventListener('click', () => {
        document.dispatchEvent(new CustomEvent('resetFilters'));
        applyFilters({
          level: 'all',
          format: 'all',
          examType: 'all',
          sort: 'featured',
          resourceType: 'any',
          search: '',
        });
      });
    }

    window.addEventListener('filterChange', handleFilterChange as EventListener);

    const observeElements = () => {
      const observer = getSharedObserver();
      document.querySelectorAll('.product-grid-item').forEach((item) => {
        if (!item.classList.contains('hidden')) observer.observe(item);
      });
    };

    // This site builds as fully static output with no SSR adapter — the
    // markup above was rendered at BUILD time, when there is no real request
    // and therefore no query string. A deep link like ?level=basic only
    // reflects the right products because this runs client-side, where
    // location.search is the actual browser URL. Skips the loading/animation
    // choreography (this is a correction on first paint, not a user action).
    const initialParams = parseCatalogParams(new URLSearchParams(window.location.search));
    const isNonDefault =
      initialParams.level !== DEFAULT_LEVEL ||
      initialParams.format !== DEFAULT_FORMAT ||
      initialParams.sort !== DEFAULT_SORT ||
      initialParams.search !== DEFAULT_SEARCH ||
      initialParams.resourceType !== DEFAULT_RESOURCE_TYPE;

    if (isNonDefault) {
      const visibleCount = computeAndApply(initialParams);
      emptyState?.classList.toggle('hidden', visibleCount !== 0);
      window.dispatchEvent(
        new CustomEvent('updateFilterCount', { detail: { count: visibleCount } })
      );
    }

    observeElements();
  });
</script>

<style>
  .product-grid-item {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.4s cubic-bezier(0.215, 0.61, 0.355, 1);
  }

  .product-grid-item.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  .product-grid-item:nth-child(4n + 1) {
    transition-delay: 0.05s;
  }
  .product-grid-item:nth-child(4n + 2) {
    transition-delay: 0.1s;
  }
  .product-grid-item:nth-child(4n + 3) {
    transition-delay: 0.15s;
  }
  .product-grid-item:nth-child(4n + 4) {
    transition-delay: 0.2s;
  }

  .loading-container {
    animation: fadeIn 0.3s ease-in forwards;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .catalog-container {
    width: 100%;
  }
</style>
